{
  "title": "link_detection verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "confidence",
    "needs_human",
    "needs_human_reason",
    "injection_suspected",
    "links"
  ],
  "properties": {
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "needs_human": { "type": "boolean" },
    "needs_human_reason": { "type": ["string", "null"] },
    "injection_suspected": { "type": "boolean" },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "kind", "risk"],
        "properties": {
          "url": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["google_form", "yandex_form", "ats", "calendar", "test_platform", "messenger", "other"]
          },
          "risk": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      }
    }
  }
}
