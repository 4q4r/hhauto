{
  "title": "link_detection verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "confidence",
    "needs_human",
    "needs_human_reason",
    "injection_suspected",
    "links",
    "summary"
  ],
  "properties": {
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "needs_human": {
      "type": "boolean"
    },
    "needs_human_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "injection_suspected": {
      "type": "boolean"
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "kind",
          "risk",
          "recommendation",
          "evidence_quote"
        ],
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "kind": {
            "type": "string",
            "enum": [
              "google_form",
              "yandex_form",
              "ats",
              "calendar",
              "test_platform",
              "messenger",
              "other"
            ]
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "recommendation": {
            "type": "string",
            "enum": [
              "review",
              "ignore"
            ]
          },
          "evidence_quote": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
